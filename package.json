{
  "name": "vgs-client",
  "version": "1.0.0",
  "description": "VGS Companion App — Electron client with overlay and audio callouts",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "start:admin": "start-admin.bat",
    "build": "electron-builder --win",
    "generate-sounds": "node scripts/generate-sounds.js"
  },
  "dependencies": {
    "koffi": "^2.15.2",
    "uiohook-napi": "^1.5.4",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "electron": "^30.1.2",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.vgs.companion",
    "productName": "VGS Companion",
    "win": {
      "target": "nsis",
      "requestedExecutionLevel": "requireAdministrator"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "vgs/**/*",
      "assets/**/*"
    ]
  }
}
